# Copying this file is not enough. Run install.ps1.
# It creates .env and stores the password hash in data\password.hash.
# Do not put a password in this file.

HOST=auto
PORT=8787
STORAGE_DIR=D:\PhoneUploads
MAX_UPLOAD_BYTES=21474836480
CHUNK_SIZE_BYTES=4194304
ALLOWED_EXTENSIONS=.mp4,.mov,.mkv,.webm,.avi,.3gp,.m4v,.jpg,.jpeg,.png,.heic,.heif,.gif,.webp
APP_USERNAME=owner
SESSION_MAX_HOURS=168
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
COOKIE_SECURE=false
INCOMPLETE_MAX_AGE_HOURS=168
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=5
